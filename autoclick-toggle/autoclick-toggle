#!/usr/bin/env bash

PIDFILE="${XDG_RUNTIME_DIR}/autoclick.pid"

if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    kill "$(cat "$PIDFILE")"
    rm -f "$PIDFILE"
    notify-send "Autoclicker" "Stopped"
else
    rm -f "$PIDFILE"

    (
        while true; do
            ydotool click 0xC0
            sleep 0.02
        done
    ) >/dev/null 2>&1 &

    echo $! > "$PIDFILE"
    notify-send "Autoclicker" "Started"
fi
